# Byte hashes identify scientific datasets; Git must not translate their EOLs.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Validation reports also record exact source bytes across Windows/Linux clones.
*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.rs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Scientific protocols and reports are also identified by exact byte hashes.
*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
requirements/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/validation/*.441 -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
scripts/validation/*.bin -text
# Archived experiment source text is byte-bound by regression reports too.
scripts/validation/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep the isolated solver build/provenance inputs byte-stable on checkout.
rust/solar_adaptive/Cargo.toml -text
rust/solar_adaptive/Cargo.lock -text
rust/solar_adaptive/LICENSE-SCIPY.txt -text

# Candidate metadata are byte-bound scientific provenance.
pyproject.toml -text
rust/solar_core/Cargo.toml -text
rust/solar_native/Cargo.toml -text
rust/solar_native/pyproject.toml -text
rust/solar_core/Cargo.lock -text
rust/solar_native/Cargo.lock -text
src/solar_simulator/data/ERFA-LICENSE.txt -text
